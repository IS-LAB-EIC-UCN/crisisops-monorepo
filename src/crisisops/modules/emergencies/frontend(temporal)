<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CrisisOps | Emergencias</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:#17283d;background:#f3f6fa}*{box-sizing:border-box}body{margin:0}.top{background:#14243c;color:white;padding:19px max(24px,calc((100vw - 1100px)/2));display:flex;justify-content:space-between;align-items:center;gap:15px}.brand{font-size:23px;font-weight:800;letter-spacing:-.7px}.brand span{color:#67d4c0}.top small{color:#c4d2e3}.shell{max-width:1100px;margin:34px auto;padding:0 22px}.eyebrow{color:#087f7c;font-size:12px;text-transform:uppercase;letter-spacing:1.4px;font-weight:800}.heading{font-size:30px;letter-spacing:-.8px;margin:8px 0}.intro{color:#64748b;margin:0 0 24px;line-height:1.5}.layout{display:grid;grid-template-columns:1.55fr 1fr;gap:20px}.panel{background:white;border:1px solid #e1e8f0;border-radius:15px;padding:25px;box-shadow:0 6px 24px #172b4d0a}.panel h2{font-size:19px;margin:0 0 7px}.muted{color:#718096;font-size:13px;margin:0 0 21px;line-height:1.5}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:flex;flex-direction:column;gap:7px}.full{grid-column:1/-1}label{font-size:13px;font-weight:650}label span{color:#c04444}input,select,textarea{width:100%;font:inherit;font-size:14px;border:1px solid #d4dce6;border-radius:8px;padding:11px 12px;background:white;color:#26344a;outline:none}input:focus,select:focus,textarea:focus{border-color:#138e8b;box-shadow:0 0 0 3px #138e8b1a}input[readonly]{background:#f6f8fb;color:#6c7889}textarea{min-height:104px;resize:vertical}.hint{font-size:11px;color:#7b8796}.actions{display:flex;gap:10px;margin-top:21px;flex-wrap:wrap}button{cursor:pointer;font-weight:700;border-radius:8px;border:1px solid #ccd6e0;padding:11px 15px;background:white;color:#344054}button.primary{background:#087e79;color:white;border-color:#087e79}button:hover{filter:brightness(.96)}button:disabled{opacity:.5;cursor:not-allowed}.summary{background:#f7f9fc;border:1px solid #e5ebf2;border-radius:10px;padding:16px;margin-bottom:16px}.summary-row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:12px 0;font-size:13px}.summary-row span:first-child{color:#64748b}.summary-row strong{text-align:right;overflow-wrap:anywhere}.pill{display:inline-flex;align-items:center;padding:5px 10px;border-radius:20px;background:#fff3d9;color:#936600;font-size:12px;font-weight:750}.pill.ok{background:#ddf6ed;color:#147c58}.pill.bad{background:#fee9e8;color:#b33636}.notice{font-size:13px;border-radius:9px;padding:13px 14px;background:#eaf5ff;color:#285e85;line-height:1.55;white-space:pre-line}.notice.error{background:#fff0ef;color:#9e3333}.notice.success{background:#e7f7ef;color:#146944}.history{margin-top:20px;font-size:13px;color:#64748b}.history strong{color:#334155}.history p{margin:9px 0}.foot{margin:28px 0;text-align:center;color:#94a3b8;font-size:12px}@media(max-width:800px){.layout{grid-template-columns:1fr}.top{padding:17px 22px}.heading{font-size:25px}}@media(max-width:500px){.fields{grid-template-columns:1fr}.panel{padding:18px}.top small{font-size:11px}}
</style></head><body>
<header class="top"><div class="brand">Crisis<span>Ops</span></div><small>Grupo A · Emergencias y evaluación</small></header>
<main class="shell"><div class="eyebrow">Panel de gestión · Sprint 1</div><h1 class="heading">Registro de emergencias</h1><p class="intro">Registra una emergencia con datos mínimos en estado <b>REPORTED</b>. Después completa sus antecedentes y valida el reporte.</p>
<div class="layout"><section class="panel"><h2>Nueva emergencia</h2><p class="muted">Los campos con * son obligatorios para el registro inicial. Los demás pueden completarse antes de validar.</p>
<form id="emergencyForm" novalidate><div class="fields">
<div class="field"><label for="type">Tipo de emergencia <span>*</span></label><select id="type"><option value="">Seleccionar tipo</option><option value="FIRE">Incendio (FIRE)</option><option value="FLOOD">Inundación (FLOOD)</option><option value="ACCIDENT">Accidente (ACCIDENT)</option><option value="MEDICAL">Emergencia médica (MEDICAL)</option><option value="OTHER">Otro (OTHER)</option></select></div>
<div class="field" id="detailWrap" hidden><label for="type_detail">Especificar  <span>*</span></label><input id="type_detail" placeholder="Indica el tipo de emergencia"></div>
<div class="field full"><label for="title">Título <span>*</span></label><input id="title" maxlength="120" placeholder="Ej.: Incendio en sector residencial"></div>
<div class="field full"><label for="location_description">Ubicación <span>*</span></label><input id="location_description" placeholder="Ej.: Avenida Costanera, Coquimbo"></div>
<div class="field full"><label for="description">Descripción (información entregada) </label><textarea id="description" placeholder="Antecedentes, situación observada y contexto..."></textarea><span class="hint">Necesaria para la validación en esta demostración.</span></div>
<div class="field full"><label for="reported_by">Reportado por</label><input id="reported_by" placeholder="Nombre o identificador del informante"><span class="hint">Necesario para la validación en esta demostración.</span></div>
<div class="field"><label for="created_at">Fecha de creación</label><input id="created_at" readonly placeholder="Se asigna al registrar"></div>

<div class="field"><label for="updated_at">Última actualización</label><input id="updated_at" readonly placeholder="Se asigna al registrar"></div>
</div><div class="actions"><button class="primary" type="submit" id="save">Registrar emergencia</button><button type="button" id="clear">Nueva emergencia</button></div></form></section>
<aside class="panel"><h2>Revisión del reporte</h2><p class="muted">Comprueba los datos y valida una emergencia registrada.</p>
<div class="summary"><div class="summary-row"><span>Identificador (id)</span><strong id="idText">Sin registrar</strong></div><div class="summary-row"><span>Estado (status)</span><span class="pill" id="status">Sin registrar</span></div><div class="summary-row"><span>Campos para validar</span><strong id="completion">0 de 5</strong></div></div>
<div class="notice" id="message" role="status" aria-live="polite">Completa los datos mínimos y registra la emergencia.</div>
<div class="actions"><button type="button" class="primary" id="validate">Validar reporte</button><button type="button" id="check">Revisar campos</button></div>
<div class="history"><strong>Historias del Sprint 1</strong><p>HU-04 · Registro inicial (REPORTED)</p><p>HU-05 · Detección de datos faltantes</p><p>HU-01 · Validación (VALIDATED)</p></div>
</aside></div><p class="foot">CrisisOps · Prototipo local </p></main>

<script>

const el=id=>document.getElementById(id);
const initial=['type','title','location_description'];
const validation=['type','title','location_description','description','reported_by'];
const labels={type:'Tipo de emergencia',type_detail:'Especificación del tipo',title:'Título',location_description:'Ubicación',description:'Descripción detallada',reported_by:'Reportado por'};
let record=null, dirty=false;
const value=id=>el(id).value.trim();
const requiredForValidation=()=>[...validation,...(value('type')==='OTHER'?['type_detail']:[])];
const missing=fields=>fields.filter(id=>!value(id));
function status(label,kind=''){el('status').textContent=label;el('status').className='pill '+kind}
function notify(message,kind=''){el('message').textContent=message;el('message').className='notice '+kind}
function stamp(){return new Date().toLocaleString('es-CL')}
function snapshot(){return Object.fromEntries(['type','type_detail','title','description','location_description','reported_by'].map(id=>[id,value(id)]))}
function refresh(){const req=requiredForValidation();el('completion').textContent=`${req.length-missing(req).length} de ${req.length}`;el('detailWrap').hidden=value('type')!=='OTHER';if(record){dirty=JSON.stringify(snapshot())!==JSON.stringify(record.data);if(dirty)notify('Hay cambios sin guardar. Guarda la actualización antes de validar.')}}
['type','type_detail','title','description','location_description','reported_by'].forEach(id=>el(id).addEventListener('input',refresh));
el('emergencyForm').onsubmit=e=>{e.preventDefault();const absent=missing([...initial,...(value('type')==='OTHER'?['type_detail']:[])]);if(absent.length){notify('No se puede registrar. Faltan: '+absent.map(id=>labels[id]).join(', ')+'.','error');return}const now=stamp();if(!record){record={id:'LOCAL-'+String(Date.now()).slice(-7),status:'REPORTED',created_at:now,data:snapshot()};el('created_at').value=now}else{record.data=snapshot();if(record.status==='VALIDATED')record.status='REPORTED'}el('updated_at').value=now;el('idText').textContent=record.id;status(record.status,record.status==='VALIDATED'?'ok':'');dirty=false;el('save').textContent='Guardar cambios';notify('Emergencia guardada localmente en estado '+record.status+'. Puedes revisar los campos y solicitar validación.','success');refresh()};
el('check').onclick=()=>{const req=requiredForValidation(),absent=missing(req);notify(absent.length?'Para validar faltan: '+absent.map(id=>labels[id]).join(', ')+'.':'Todos los campos requeridos para validar están completos.',absent.length?'error':'success')};
el('validate').onclick=()=>{if(!record){notify('Primero registra la emergencia con los campos mínimos.','error');return}if(dirty){notify('Guarda los cambios antes de validar.','error');return}const absent=missing(requiredForValidation());if(absent.length){notify('La emergencia sigue en REPORTED. Para validarla faltan: '+absent.map(id=>labels[id]).join(', ')+'.','error');return}record.status='VALIDATED';el('updated_at').value=stamp();status('VALIDATED','ok');notify('Reporte validado correctamente. Estado actualizado a VALIDATED.','success')};
el('clear').onclick=()=>{el('emergencyForm').reset();record=null;dirty=false;el('created_at').value='';el('updated_at').value='';el('idText').textContent='Sin registrar';el('save').textContent='Registrar emergencia';status('Sin registrar');notify('Completa los datos mínimos y registra la emergencia.');refresh()};refresh();
</script></body></html>
